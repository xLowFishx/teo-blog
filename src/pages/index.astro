---
import "../styles/global.css";
import WebBaseLayout from "../layouts/WebBaseLayout.astro";
import BlogPostSuggestion from "../components/BlogPostSuggestion";

const pageTitle = "Inicio";

const blogsData = Object.values(
	import.meta.glob("./posts/*.md", { eager: true }),
);

const recentBlogs = [...blogsData].sort(
	(blogDataA: any, blogDataB: any) =>
		new Date(blogDataA.frontmatter.pubDate).getTime() -
		new Date(blogDataB.frontmatter.pubDate).getTime(),
).slice(0, 3);
---

<WebBaseLayout pageTitle={pageTitle}>
	<h1>El blog Teo</h1>

	<p>
		Un blog de teología, apologética, y otros temas relacionados con la vida
		cristiana.
	</p>

	<h3>Blogs recientes:</h3>
	<ul>
		{
			recentBlogs.map((blogData: any) => (
				<li>
					<a href={blogData.frontmatter.location}>
						{blogData.frontmatter.title}
					</a>
				</li>
			))
		}
	</ul>

	<BlogPostSuggestion client:load />
</WebBaseLayout>
